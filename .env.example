# Only needed when deploying serverless (Vercel) or running more than one instance.
# Without these, room state is kept in the process's memory, which is fine for
# `pnpm dev` and for a single long-lived container.
#
# On Vercel you do NOT set these by hand: Storage -> Create Database ->
# Upstash for Redis injects them, then redeploy once.
#
# Depending on the integration you get either naming scheme below; both point at
# the same REST endpoint and the app accepts either. Only the URL + the
# read/write token are used.
#
# KV_URL / REDIS_URL (TCP, rediss://) and KV_REST_API_READ_ONLY_TOKEN are NOT
# used by this app -- @upstash/redis speaks HTTP and the game needs write access.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ...or:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
