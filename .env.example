# Only needed when deploying serverless (Vercel) or running more than one instance.
# Without these, room state is kept in the process's memory, which is fine for
# `pnpm dev` and for a single long-lived container.
#
# On Vercel: Storage -> Create Database -> Upstash for Redis sets these for you.
# The app also accepts KV_REST_API_URL / KV_REST_API_TOKEN.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
